APP_NAME=Locsy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# От этого URL зависят абсолютные ссылки на фотографии (asset('storage/...')),
# поэтому в продакшене здесь должен быть реальный домен с https.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=locsy
DB_USERNAME=sail
DB_PASSWORD=password

# Адрес SPA (используется в CORS) и домены со stateful-сессией Sanctum
FRONTEND_URL=http://localhost:9000
SANCTUM_STATEFUL_DOMAINS=localhost:9000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Почта. Локально — Mailpit из docker-compose (docker compose up -d mailpit,
# письма видны на http://localhost:8025). Быстрый вариант без Mailpit:
# MAIL_MAILER=log → storage/logs/laravel.log.
# На обкатке/проде: MAIL_MAILER=smtp, MAIL_SCHEME=smtps, MAIL_HOST=smtp.beget.com,
# MAIL_PORT=465, MAIL_USERNAME/MAIL_FROM_ADDRESS=no-reply@<домен>.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@locsy.local"
MAIL_FROM_NAME="Locsy"
# Ответы пользователей уводим на живой ящик, а сами письма уходят с no-reply@
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="Locsy"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
